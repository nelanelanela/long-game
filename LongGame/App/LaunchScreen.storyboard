<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LGLaunch">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--The still night frame: navy sky, faint stars, the sleeping sun half under an opaque night sea. No text. See docs/SPEC.md section 21. -->
        <scene sceneID="LGScene">
            <objects>
                <viewController id="LGLaunch" sceneMemberID="viewController">
                    <view key="view" clipsSubviews="YES" contentMode="scaleToFill" id="LGRoot">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view hidden="YES" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="LGWaterline">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="477"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchStars" translatesAutoresizingMaskIntoConstraints="NO" id="LGStars" userLabel="Stars">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="426"/>
                                <accessibility key="accessibilityConfiguration">
                                    <bool key="isElement" value="NO"/>
                                </accessibility>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchSun" translatesAutoresizingMaskIntoConstraints="NO" id="LGSun" userLabel="Sleeping sun">
                                <rect key="frame" x="111.5" y="369" width="170" height="170"/>
                            </imageView>
                            <view userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="LGSeaFill" userLabel="Sea fill">
                                <rect key="frame" x="0.0" y="516" width="393" height="336"/>
                                <color key="backgroundColor" name="LaunchSea"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchSea" translatesAutoresizingMaskIntoConstraints="NO" id="LGSeaWave" userLabel="Sea waves">
                                <rect key="frame" x="-523.5" y="467" width="1440" height="50"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchSky"/>
                        <constraints>
                            <constraint firstItem="LGWaterline" firstAttribute="top" secondItem="LGRoot" secondAttribute="top" id="c1"/>
                            <constraint firstItem="LGWaterline" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c2"/>
                            <constraint firstItem="LGWaterline" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c3"/>
                            <constraint firstItem="LGWaterline" firstAttribute="height" secondItem="LGRoot" secondAttribute="height" multiplier="0.56" id="c4"/>
                            <constraint firstItem="LGStars" firstAttribute="top" secondItem="LGRoot" secondAttribute="top" id="c5"/>
                            <constraint firstItem="LGStars" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c6"/>
                            <constraint firstItem="LGStars" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c7"/>
                            <constraint firstItem="LGStars" firstAttribute="height" secondItem="LGRoot" secondAttribute="height" multiplier="0.5" id="c8"/>
                            <constraint firstItem="LGSun" firstAttribute="centerX" secondItem="LGRoot" secondAttribute="centerX" id="c9"/>
                            <constraint firstItem="LGSun" firstAttribute="centerY" secondItem="LGWaterline" secondAttribute="bottom" constant="-23" id="c10"/>
                            <constraint firstAttribute="width" constant="170" id="c11" firstItem="LGSun"/>
                            <constraint firstAttribute="height" constant="170" id="c12" firstItem="LGSun"/>
                            <constraint firstItem="LGSeaWave" firstAttribute="centerX" secondItem="LGRoot" secondAttribute="centerX" id="c13"/>
                            <constraint firstItem="LGSeaWave" firstAttribute="top" secondItem="LGWaterline" secondAttribute="bottom" constant="-10" id="c14"/>
                            <constraint firstAttribute="width" constant="1440" id="c15" firstItem="LGSeaWave"/>
                            <constraint firstAttribute="height" constant="50" id="c16" firstItem="LGSeaWave"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="top" secondItem="LGSeaWave" secondAttribute="bottom" constant="-1" id="c17"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c18"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c19"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="bottom" secondItem="LGRoot" secondAttribute="bottom" id="c20"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LGFirst" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
