<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LGLaunch">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--The still night frame: navy sky, faint stars, the sleeping sun half under an opaque night sea. No text. See docs/SPEC.md section 21. -->
        <scene sceneID="LGScene">
            <objects>
                <viewController id="LGLaunch" sceneMemberID="viewController">
                    <view key="view" clipsSubviews="YES" contentMode="scaleToFill" id="LGRoot">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view hidden="YES" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="LGWaterline">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="511"/>
                            </view>
                            <view hidden="YES" userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="LGShoreOffset">
                                <rect key="frame" x="0.0" y="466" width="393" height="45"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchNightSky" translatesAutoresizingMaskIntoConstraints="NO" id="LGSky" userLabel="Night sky">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="511"/>
                                <accessibility key="accessibilityConfiguration">
                                    <bool key="isElement" value="NO"/>
                                </accessibility>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchSun" translatesAutoresizingMaskIntoConstraints="NO" id="LGSun" userLabel="Sleeping sun">
                                <rect key="frame" x="121.5" y="436" width="150" height="150"/>
                            </imageView>
                            <view userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="LGSeaFill" userLabel="Sea fill">
                                <rect key="frame" x="0.0" y="588" width="393" height="264"/>
                                <color key="backgroundColor" name="LaunchSea"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchNightLand" translatesAutoresizingMaskIntoConstraints="NO" id="LGLand" userLabel="Night land and sea">
                                <rect key="frame" x="0.0" y="466" width="393" height="121"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchSky"/>
                        <constraints>
                            <constraint firstItem="LGWaterline" firstAttribute="top" secondItem="LGRoot" secondAttribute="top" id="c1"/>
                            <constraint firstItem="LGWaterline" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c2"/>
                            <constraint firstItem="LGWaterline" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c3"/>
                            <constraint firstItem="LGWaterline" firstAttribute="height" secondItem="LGRoot" secondAttribute="height" multiplier="0.6" id="c4"/>
                            <constraint firstItem="LGSky" firstAttribute="top" secondItem="LGRoot" secondAttribute="top" id="c5"/>
                            <constraint firstItem="LGSky" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c6"/>
                            <constraint firstItem="LGSky" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c7"/>
                            <constraint firstItem="LGSky" firstAttribute="bottom" secondItem="LGWaterline" secondAttribute="bottom" id="c8"/>
                            <constraint firstItem="LGSun" firstAttribute="centerX" secondItem="LGRoot" secondAttribute="centerX" id="c9"/>
                            <constraint firstItem="LGSun" firstAttribute="centerY" secondItem="LGWaterline" secondAttribute="bottom" id="c10"/>
                            <constraint firstAttribute="width" constant="150" id="c11" firstItem="LGSun"/>
                            <constraint firstAttribute="height" constant="150" id="c12" firstItem="LGSun"/>
                            <constraint firstItem="LGLand" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c13"/>
                            <constraint firstItem="LGLand" firstAttribute="trailing" secondItem="LGRoot" secondAttribute="trailing" id="c14"/>
                            <constraint firstItem="LGLand" firstAttribute="height" secondItem="LGLand" secondAttribute="width" multiplier="0.3077" id="c15"/>
                            <constraint firstItem="LGShoreOffset" firstAttribute="bottom" secondItem="LGWaterline" secondAttribute="bottom" id="c16"/>
                            <constraint firstItem="LGShoreOffset" firstAttribute="height" secondItem="LGLand" secondAttribute="height" multiplier="0.3833" id="c17"/>
                            <constraint firstItem="LGShoreOffset" firstAttribute="width" secondItem="LGRoot" secondAttribute="width" id="c18"/>
                            <constraint firstItem="LGLand" firstAttribute="top" secondItem="LGShoreOffset" secondAttribute="top" id="c19"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="top" secondItem="LGLand" secondAttribute="bottom" constant="-1" id="c20"/>
                            <constraint firstItem="LGSeaFill" firstAttribute="leading" secondItem="LGRoot" secondAttribute="leading" id="c21"/>
